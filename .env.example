# Copy this file to .env and set the path on your machine.
# .env is ignored by git; do not commit local paths.

# Folder with large external data (not tracked in git).
# Expected layout:
#   $CR2SUB_HEAVY_DATA/CLSoilMaps/SoilMaps_MEAN
#   $CR2SUB_HEAVY_DATA/CLSoilMaps/ROSETTA_MEAN
# Download from https://zenodo.org/records/7464210
CR2SUB_HEAVY_DATA=/path/to/cr2sub/heavy_data
